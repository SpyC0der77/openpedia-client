# Auth.js - required for session encryption
# Generate with: npx auth secret
AUTH_SECRET=

# Wikimedia OAuth 2.0 - register at:
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
#
# Add redirect URL: http://localhost:3000/api/auth/callback/wikimedia
# (or https://your-domain.com/api/auth/callback/wikimedia for production)
#
# For "User identity verification only" scope, approval is typically faster.
AUTH_WIKIMEDIA_ID=
AUTH_WIKIMEDIA_SECRET=
